DATABASE_URL=sqlite:///./db.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Select auto, openai, or ollama. Auto tries OpenAI when a key exists, then Ollama.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Hindsight API server must be running separately; its own LLM configuration is managed there.
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_PREFIX=standford-customer

REQUEST_TIMEOUT_SECONDS=30
AUTH_TOKEN_TTL_SECONDS=28800
